# Python virtual environment (rebuildable from requirements.txt)
.venv/
__pycache__/
*.pyc

# Data & database — everything in data/ is downloaded/generated & regenerable.
# Ignore it all, but keep the empty folder via .gitkeep.
data/*
!data/.gitkeep

# macOS clutter
.DS_Store

# Editor / OS
.idea/
*.log

# Claude Code tooling (not part of the project)
.claude/
.agents/
